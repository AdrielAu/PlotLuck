# Local link to .agents/skills, created per clone (see docs/setup.md)
.claude/skills
.claude/settings.local.json

# Design-skill working files (direction sheet, inspector screenshots)
.taste-skill/

# Agent worktrees: disposable, per clone
.claude/worktrees/

# Claude hook scripts: per clone, opt-in (see docs/setup.md)
.claude/hooks/

# Server-only full data, virtualenv
data/full/
.venv/

# Model checkpoints and intermediate arrays (results go in runs/, final weights in web/models/)
*.keras
*.pt
*.h5
*.npy
*.npz

# Python build artifacts
__pycache__/
*.egg-info/
